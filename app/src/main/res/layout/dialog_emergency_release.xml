<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvEmergencyReleaseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 Emergency Force Release"
        android:textColor="@color/slot_occupied_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Parking Association Limitation: Force release requires selecting a Rule Violation &amp; mandatory incident photo proof."
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="italic" />

    <!-- Rule Violation Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Select Association Rule Violation:"
        android:textColor="@color/slate_900"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerViolationReason"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rounded_badge_occupied"
        android:paddingHorizontal="12dp" />

    <!-- Photo Proof Container -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Incident Photo Proof (Mandatory):"
        android:textColor="@color/slate_900"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/slate_50"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgProofPreview"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="Incident Photo Preview"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureProof"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Take Incident Photo"
                android:textColor="@color/slate_900"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/slate_900"
                app:strokeWidth="1.5dp" />

            <TextView
                android:id="@+id/tvProofStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⚠️ Photo proof not captured yet"
                android:textColor="@color/slot_occupied_text"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEmergencyRelease"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#475569" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmEmergencyRelease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/slot_occupied_stroke"
            android:enabled="false"
            android:text="Confirm Release with Proof"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
