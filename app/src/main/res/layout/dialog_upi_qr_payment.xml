<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvUpiDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳 Mock Payment Gateway"
        android:textColor="@color/slate_900"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpiAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Total Amount to Pay: ₹40"
        android:textColor="@color/accent_indigo"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Payment Gateway Options Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Payment Method (Simulated)"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgPaymentMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbPayUpi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_indigo"
                    android:checked="true"
                    android:paddingVertical="4dp"
                    android:text="⚡ Instant UPI / GPay / PhonePe"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbPayCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_indigo"
                    android:paddingVertical="4dp"
                    android:text="💳 Credit / Debit Card"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbPayNetBanking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_indigo"
                    android:paddingVertical="4dp"
                    android:text="🏦 NetBanking / Wallet"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="✓ Fast 1-Tap Simulated Checkout for Testing"
                android:textColor="@color/slot_available_text"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Optional Reference Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUtrNumber"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Transaction Reference (Optional)"
        app:boxStrokeColor="@color/slate_900"
        app:hintTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUtrNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLength="15"
            android:maxLines="1"
            android:textColor="@color/slate_900"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelUpi"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#475569" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmUpiPayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/slate_900"
            android:paddingHorizontal="16dp"
            android:text="⚡ Pay &amp; Confirm Booking →"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
