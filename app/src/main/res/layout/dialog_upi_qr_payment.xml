<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvUpiDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 Google Pay / UPI Payment"
        android:textColor="@color/slate_900"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUpiAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Total Amount to Pay: ₹40"
        android:textColor="@color/accent_indigo"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- QR Code Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgUpiQrCode"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="Google Pay QR Code"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/tvUpiId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rounded_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="UPI ID: parksmart@okaxis"
                android:textColor="@color/slate_900"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Accepted: Google Pay • PhonePe • Paytm • BHIM"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- UTR Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUtrNumber"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="12-Digit UTR / Transaction Ref No."
        app:boxStrokeColor="@color/slate_900"
        app:counterEnabled="true"
        app:counterMaxLength="12"
        app:hintTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUtrNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="12"
            android:maxLines="1"
            android:textColor="@color/slate_900"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelUpi"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#475569" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmUpiPayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/slate_900"
            android:text="Confirm Payment &amp; Book →"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
