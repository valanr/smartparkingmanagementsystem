<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvBookSlotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book Parking Slot"
        android:textColor="@color/slate_900"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRateNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Standard Rate: ₹20 / Hour"
        android:textColor="@color/accent_indigo"
        android:textSize="13sp"
        android:textStyle="italic" />

    <!-- Vehicle Number -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilVehicleNumber"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Vehicle Number (e.g. MH12AB1234)"
        app:boxStrokeColor="@color/slate_900"
        app:hintTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVehicleNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLength="12"
            android:maxLines="1"
            android:textColor="@color/slate_900"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Phone Number -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPhoneNumber"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Mobile Number"
        app:boxStrokeColor="@color/slate_900"
        app:counterEnabled="true"
        app:counterMaxLength="10"
        app:counterTextColor="@color/slate_900"
        app:hintTextColor="@color/slate_900"
        app:prefixText="+91 "
        app:prefixTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLength="10"
            android:maxLines="1"
            android:textColor="@color/slate_900"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Duration in Hours -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBookingHours"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Duration (1 - 24 Hours)"
        app:boxStrokeColor="@color/slate_900"
        app:hintTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBookingHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="2"
            android:maxLines="1"
            android:text="1"
            android:textColor="@color/slate_900"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Fee Calculation Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/slot_available_bg"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/slot_available_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Payable Amount:"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstimatedFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹20"
                android:textColor="@color/slot_available_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBook"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#475569" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/slate_900"
            android:text="Confirm Booking"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
