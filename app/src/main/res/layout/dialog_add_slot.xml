<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="➕ Add New Building Slot"
        android:textColor="@color/slate_900"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Expand parking capacity according to building layout and floor plans."
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Slot Number -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Slot Index Number (e.g. 11)"
        app:boxStrokeColor="@color/slate_900"
        app:hintTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAddSlotNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:maxLines="1"
            android:textColor="@color/slate_900" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Custom Slot Code -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Custom Slot Code (e.g. B1-105)"
        app:boxStrokeColor="@color/slate_900"
        app:hintTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAddSlotCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLength="10"
            android:maxLines="1"
            android:textColor="@color/slate_900" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Floor / Zone -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Building Floor / Zone (e.g. Basement B1)"
        app:boxStrokeColor="@color/slate_900"
        app:hintTextColor="@color/slate_900">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAddSlotFloor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:text="Basement B1"
            android:textColor="@color/slate_900" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Vehicle Category"
        android:textColor="@color/slate_900"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgAddCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAddBike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/bike_accent"
            android:checked="false"
            android:text="🏍️ Two Wheeler"
            android:textColor="@color/slate_900"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbAddCar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/car_accent"
            android:checked="true"
            android:text="🚗 Four Wheeler"
            android:textColor="@color/slate_900"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RadioGroup>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAddSlot"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#475569" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNewSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/slate_900"
            android:text="Save &amp; Create Slot"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
